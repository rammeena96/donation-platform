# ================================
# DATABASE
# ================================
DATABASE_URL="postgresql://user:password@localhost:5432/donation_db"

# ================================
# NEXTAUTH (Required)
# ================================
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ================================
# RAZORPAY (Required for payments)
# ================================
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXXXX"

# ================================
# SITE SETTINGS
# ================================
NEXT_PUBLIC_SITE_NAME="Divine Mission"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ================================
# EMAIL (Nodemailer - Gmail SMTP)
# ================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="your@gmail.com"

# ================================
# BANK / UPI (Displayed on website)
# ================================
NEXT_PUBLIC_UPI_ID="yourname@bank"
NEXT_PUBLIC_BANK_NAME="Your Bank Name"
NEXT_PUBLIC_BANK_ACCOUNT="XXXX XXXX XXXX XXXX"
NEXT_PUBLIC_BANK_IFSC="XXXX0000000"
NEXT_PUBLIC_BANK_BENEFICIARY="Your Organization Name"

# ================================
# CONTACT INFO
# ================================
NEXT_PUBLIC_CONTACT_PHONE="+91-9876543210"
NEXT_PUBLIC_CONTACT_EMAIL="info@yourdomain.com"
NEXT_PUBLIC_CONTACT_ADDRESS="Your Address, City, State - PIN"

# ================================
# SOCIAL MEDIA
# ================================
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/yourpage"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourpage"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@yourchannel"
NEXT_PUBLIC_TWITTER_URL="https://twitter.com/yourhandle"
